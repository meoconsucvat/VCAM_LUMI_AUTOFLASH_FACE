[Unit]
Description=<PROJECT_NAME> Telegram Admin Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/<PROJECT_NAME>
EnvironmentFile=/opt/<PROJECT_NAME>/.env
ExecStart=/opt/<PROJECT_NAME>/venv/bin/python /opt/<PROJECT_NAME>/vcam_telegram_admin_bot.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

