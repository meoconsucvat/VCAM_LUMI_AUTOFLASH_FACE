# Production env template khớp biến app.py backend_reference đang đọc.
# Copy sang VPS (vd /opt/<PROJECT>/.env hoặc /etc/<project>.env) — KHÔNG commit secret thật.
# Không in token/password/private key ra log/report.

# --- Core paths ---
VCAM_DB=/opt/<PROJECT_NAME>/vcam.db
VCAM_ED25519_KEY=/opt/<PROJECT_NAME>/server_ed25519.key

# --- Public identity (URL phải 27 UTF-8 bytes: https:// + host14 + /vcam) ---
VCAM_PUBLIC_BASE_URL=https://<HOST_14_BYTES>/vcam

# --- Auth / crypto ---
# Mặc định code dùng LEGACY_BOOTSTRAP_SECRET nếu không set. Chỉ đổi khi rekey full stack.
# VCAM_BOOTSTRAP_SECRET=<only-if-intentional-rekey>

# Marker client dùng trong HMAC — PHẢI đúng byte như trong DEB (thường 18, pad space).
# Multi-marker: marker1||marker2  (không trim nhầm trailing spaces)
# "tele: @vcamplus" + 3 spaces = 18 bytes; "tele: @lumierephan" = 18 bytes
VCAM_CODE_MARKER=tele: @vcamplus
VCAM_CODE_MARKERS=tele: @vcamplus   ||tele: @lumierephan
VCAM_CONTACT_HANDLE=@vcamplus

# --- Session / security policy ---
VCAM_SESSION_HOURS=720
VCAM_ALLOWED_SKEW=60
VCAM_PAIRING_TTL=300
VCAM_LEGACY_RELAY_AUTO_PAIR=1
VCAM_BAD_LOGIN_LIMIT=5
# Default OFF: không auto-lock device vì gõ sai pass
VCAM_BAD_LOGIN_LOCK_ENABLED=0
VCAM_VERIFY_ALLOW_DEVICE_MISMATCH=1
VCAM_VERIFY_IGNORE_REVOKED=0

# --- Telegram (bot + admin notify chat) ---
VCAM_TELEGRAM_BOT_TOKEN=<FROM_BOTFATHER>
VCAM_TELEGRAM_CHAT_ID=<ADMIN_NUMERIC_ID>

# --- Initial seed (tắt sau khi tạo user thật nếu muốn) ---
VCAM_DISABLE_INITIAL_SEED=0
VCAM_INITIAL_USER=<DEFAULT_USERNAME>
VCAM_INITIAL_PASSWORD=<DEFAULT_PASSWORD>
VCAM_RELAY_USER=<DEFAULT_USERNAME>
VCAM_RELAY_PASSWORD=<DEFAULT_PASSWORD>

# --- Runtime ---
VCAM_LOG_LEVEL=INFO

# Ghi chú deploy:
# - Process thường bind local (vd 127.0.0.1:8443) + nginx TLS terminate.
# - Tên systemd/nginx trên VPS: verify bằng systemctl/nginx -T, không đoán.
# - /health public thường: https://<HOST>/health
# - API: https://<HOST>/vcam/...
