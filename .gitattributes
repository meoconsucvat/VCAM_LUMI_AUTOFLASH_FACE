# Normalize text; keep binaries intact
* text=auto eol=lf

*.md    text eol=lf
*.txt   text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.ps1   text eol=crlf
*.json  text eol=lf
*.sql   text eol=lf
*.conf  text eol=lf
*.service text eol=lf
*.env   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Binaries / archives
*.deb   binary
*.exe   binary
*.zip   binary
*.bin   binary
*.dll   binary
*.dylib binary
*.so    binary
*.png   binary
*.jpg   binary
*.pdf   binary

# Windows scripts stay CRLF on checkout where helpful
*.bat   text eol=crlf
*.cmd   text eol=crlf
